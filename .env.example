# Secondhand Fit — server-only configuration. Copy to .env and fill in the values.
# Never commit .env (it is gitignored). Keys are read only on the server, never shipped to the browser.

# Perfect Corp. YouCam API (https://yce.perfectcorp.com/ai-api) — API Key from the console.
# The V2 API takes it as "Authorization: Bearer <YOUCAM_API_KEY>" on every request.
YOUCAM_API_KEY=
# Optional and unused: the V2 API has no auth endpoint, so the console's Secret Key is not needed.
# YOUCAM_SECRET_KEY=

# Unit budget guard: stop calling the live API when the ledger reaches this many units.
# At the cap, try-ons are served as a labelled precomputed example and no API call is made.
YOUCAM_UNIT_BUDGET=900

# Units already spent on the account before this server process started (read it from the YouCam
# console). The ledger is in-memory, so without this the guard starts counting from 0 after every
# restart. Setting it equal to YOUCAM_UNIT_BUDGET reproduces the budget-reached fallback.
# YOUCAM_UNITS_SPENT_BASELINE=0

# Fair-use cap: try-on renders one anonymous browser session may start in any 24 hours.
# Past the cap the labelled precomputed example is served. 0 switches renders off for visitors.
# TRYON_SESSION_RENDER_CAP=5

# Offline mock mode from pinned fixtures (true = never call the live API).
# Mock mode is also forced automatically when YOUCAM_API_KEY is empty.
YOUCAM_MOCK=false

# ---- Optional overrides for the single-file adapter (lib/youcam/adapter.ts) ----
# Every value below defaults to what the adapter pins from the official YouCam API V2 documentation.
# Override only after confirming a different value empirically against the live API.
# YOUCAM_BASE_URL=https://yce-api-01.perfectcorp.com
# YOUCAM_VTO_FEATURE=cloth             # feature slug used in /s2s/v2.0/file/{feature} and /s2s/v2.0/task/{feature}
# YOUCAM_VTO_CATEGORY=upper_body       # garment_category: upper_body | lower_body | full_body | auto | shoes
# YOUCAM_POLL_TIMEOUT_MS=90000         # hard bound on polling per render
# YOUCAM_POLL_INTERVAL_MS=2000         # interval between status checks
# YOUCAM_VTO_UNIT_COST=1               # estimated units per render used by the budget guard (see /status for the API's figure)
# YOUCAM_MOCK_LATENCY_MS=4000          # how long a mock task stays "running" before it succeeds

# Secret used to sign opaque render ids returned to the browser (any long random string).
# Without it a per-process random key is used, so render ids stop working after a restart.
# RENDER_ID_SECRET=
